# Proton ANK Backend Configuration

# Modèle Nemotron
MODEL_NAME=nvidia/Nemotron-H-8B-Reasoning
MODEL_PATH=/path/to/local/model  # Si le modèle est stocké localement

# Configuration du serveur
HOST=0.0.0.0
PORT=8001
RELOAD=true

# Device (cuda ou cpu)
DEVICE=cuda

# Frontend URLs autorisés (CORS)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,https://votre-domaine.com

# Logs
LOG_LEVEL=INFO
